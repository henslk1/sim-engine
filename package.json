{
  "name": "sim-engine",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo run dev",
    "build": "turbo run build",
    "test:tutorial": "node --import tsx --test packages/trpc/test/tutorial-policy.test.ts packages/trpc/test/tutorial-guard.test.ts packages/trpc/test/tutorial-markers.test.ts",
    "test:messaging": "node --import tsx --test packages/trpc/test/messaging-permissions.test.ts packages/trpc/test/messaging-messages.test.ts packages/trpc/test/messaging-channels.test.ts packages/trpc/test/messaging-rate-limit.test.ts packages/trpc/test/messaging-architecture.test.ts",
    "test:server": "node --import tsx --test apps/server/test/socket.test.ts apps/server/test/scheduler-tick.test.ts apps/server/test/resolver-maintenance.test.ts",
    "test:engine": "node --import tsx --test packages/engine/test/aging-cache.test.ts packages/engine/test/action-guards.test.ts packages/engine/test/conformation.test.ts packages/engine/test/creation-values.test.ts packages/engine/test/schedule-time.test.ts packages/engine/test/schedule-clock.test.ts packages/engine/test/schedule-plan.test.ts packages/engine/test/schedule-architecture.test.ts packages/engine/test/competition-scoring.test.ts packages/engine/test/daily-visit.test.ts",
    "test:animal-actions": "node --import tsx --test packages/trpc/test/animal-actions.test.ts packages/trpc/test/stable-preferences.test.ts",
    "test:condition-work:db": "cross-env RUN_DATABASE_TESTS=1 node --env-file=.env --import tsx --test packages/db/test/condition-work.integration.test.ts",
    "test:retention:db": "cross-env RUN_DATABASE_TESTS=1 node --env-file=.env --import tsx --test packages/db/test/retention-markers.integration.test.ts",
    "test:concurrency:db": "cross-env RUN_DATABASE_TESTS=1 node --env-file=.env --import tsx --test --test-timeout=60000 packages/db/test/gameplay-concurrency.integration.test.ts",
    "test:maintenance:db": "cross-env RUN_DATABASE_TESTS=1 node --env-file=.env --import tsx --test packages/db/test/maintenance-lock.integration.test.ts",
    "test:scoring:db": "cross-env RUN_DATABASE_TESTS=1 node --env-file=.env --import tsx --test packages/db/test/competition-scoring.integration.test.ts",
    "test:visit:db": "cross-env RUN_DATABASE_TESTS=1 node --env-file=.env --import tsx --test packages/db/test/daily-visit.integration.test.ts",
    "test:web": "node --import tsx --test apps/web/test/connection.test.ts apps/web/test/daily-visit.test.ts",
    "test:breeds": "node --import tsx --test packages/trpc/test/breed-personality.test.ts packages/trpc/test/breed-coats.test.ts",
    "test:maintenance": "node --import tsx --test packages/trpc/test/maintenance.test.ts packages/trpc/test/gameplay-lock.test.ts packages/trpc/test/cross-game.test.ts packages/trpc/test/recovery-after-rollback.test.ts",
    "test:authorization": "node --import tsx --test packages/trpc/test/authorization-architecture.test.ts packages/trpc/test/authorization-ownership.test.ts",
    "test": "pnpm test:tutorial && pnpm test:messaging && pnpm test:server && pnpm test:web && pnpm test:engine && pnpm test:breeds && pnpm test:animal-actions && pnpm test:maintenance && pnpm test:authorization"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tsx": "^4.23.11",
    "turbo": "latest",
    "typescript": "^6.0.3"
  }
}
