enum HealthConditionType {
  ILLNESS
  INJURY
}

enum TreatmentType {
  OTC
  PRESCRIPTION
  VET_PROCEDURE
  ACTIVITY_RESTRICTION
  PLAYER_ACTION
}

enum ActivityRestrictionType {
  TRAINING
  COMPETITION
  BREEDING
  CARE_ACTION
  ALL
}

enum TestResultOutcome {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
}

enum ConditionTriggerType {
  VET_PROCEDURE
  TRAINING_TIER
}

model HealthConditionDef {
  id                     String                    @id @default(cuid())
  gameId                 String
  name                   String
  conditionType          HealthConditionType
  isGenetic              Boolean                   @default(false)
  isEpisodic             Boolean                   @default(false)
  isFatal                Boolean                   @default(false)
  onsetMinCycle          Int?
  fatalityChance         Float?
  fatalMaxCycle          Int?
  moodEffect             Float?
  energyEffect           Float?
  flareupCooldownCycles  Int?
  procedureFatalityRisk  Float?
  suppressionItemDefId   String?
  baseWeight             Float                     @default(1)
  description            Json?
  behaviors              HealthConditionBehavior[]
  treatments             TreatmentDef[]
  conditionTriggers      ConditionTrigger[]
  healthRecords          AnimalHealthRecord[]
  testResults            AnimalTestResult[]
  groupEntryRequirements GroupEntryRequirement[]
  ruleConditions         ExpressionRuleCondition[]
  vetVisitLogs           VetVisitLog[]
  vetServices            VetServiceCondition[]
  tutorialStepDefs       TutorialStepDef[]
  suppressionItem        ItemDef?                  @relation(fields: [suppressionItemDefId], references: [id])
  game                   Game                      @relation(fields: [gameId], references: [id])

  @@unique([gameId, name])
}

model HealthConditionBehavior {
  id              String             @id @default(cuid())
  conditionDefId  String
  careActionDefId String?
  symptomText     String
  conditionDef    HealthConditionDef @relation(fields: [conditionDefId], references: [id])
  careActionDef   CareActionDef?     @relation(fields: [careActionDefId], references: [id])
}

model TreatmentDef {
  id               String                    @id @default(cuid())
  conditionDefId   String
  name             String
  treatmentType    TreatmentType
  durationCycles   Int?
  cost             Int?
  currencyDefId    String?
  items            TreatmentItem[]
  treatmentRecords AnimalTreatmentRecord[]
  restrictionDefs  TreatmentRestrictionDef[]
  conditionDef     HealthConditionDef        @relation(fields: [conditionDefId], references: [id])
  currencyDef      CurrencyDef?              @relation(fields: [currencyDefId], references: [id])
}

model TreatmentRestrictionDef {
  id               String                  @id @default(cuid())
  treatmentDefId   String
  restrictionType  ActivityRestrictionType
  maxIntensityTier Int?
  durationCycles   Int?
  treatmentDef     TreatmentDef            @relation(fields: [treatmentDefId], references: [id])
}

model ConditionTrigger {
  id             String               @id @default(cuid())
  conditionDefId String
  triggerType    ConditionTriggerType
  minTierIndex   Int?
  triggerChance  Float                @default(1.0)
  conditionDef   HealthConditionDef   @relation(fields: [conditionDefId], references: [id])
}

model TreatmentItem {
  id             String       @id @default(cuid())
  treatmentDefId String
  itemDefId      String
  quantity       Int          @default(1)
  treatmentDef   TreatmentDef @relation(fields: [treatmentDefId], references: [id])
  itemDef        ItemDef      @relation(fields: [itemDefId], references: [id])

  @@unique([treatmentDefId, itemDefId])
}

model AnimalHealthRecord {
  id               String                  @id @default(cuid())
  animalId         String
  conditionDefId   String
  diagnosedCycle   Int?
  diagnosedAt      DateTime?
  resolvedCycle    Int?
  resolvedAt       DateTime?
  isActive         Boolean                 @default(true)
  treatmentRecords AnimalTreatmentRecord[]
  animal           Animal                  @relation(fields: [animalId], references: [id])
  conditionDef     HealthConditionDef      @relation(fields: [conditionDefId], references: [id])
}

model AnimalTreatmentRecord {
  id                    String                @id @default(cuid())
  animalId              String
  treatmentDefId        String
  healthRecordId        String
  startedCycle          Int
  startedAt             DateTime              @default(now())
  lastAdministeredCycle Int?
  completedCycle        Int?
  completedAt           DateTime?
  isActive              Boolean               @default(true)
  activityRestriction   ActivityRestriction[]
  animal                Animal                @relation(fields: [animalId], references: [id])
  treatmentDef          TreatmentDef          @relation(fields: [treatmentDefId], references: [id])
  healthRecord          AnimalHealthRecord    @relation(fields: [healthRecordId], references: [id])
}

model ActivityRestriction {
  id                String                  @id @default(cuid())
  animalId          String
  treatmentRecordId String?
  restrictionType   ActivityRestrictionType
  maxIntensityTier  Int?
  remainingCycles   Int
  isLifelong        Boolean                 @default(false)
  isActive          Boolean                 @default(true)
  animal            Animal                  @relation(fields: [animalId], references: [id])
  treatmentRecord   AnimalTreatmentRecord?  @relation(fields: [treatmentRecordId], references: [id])
}

model AnimalTestResult {
  id             String             @id @default(cuid())
  animalId       String
  conditionDefId String
  result         TestResultOutcome
  testedCycle    Int
  testedAt       DateTime           @default(now())
  animal         Animal             @relation(fields: [animalId], references: [id])
  conditionDef   HealthConditionDef @relation(fields: [conditionDefId], references: [id])
}

model HealthCertificateDef {
  id                     String              @id @default(cuid())
  gameId                 String
  name                   String
  validForCycles         Int
  requiredForCompetition Boolean             @default(false)
  certificates           HealthCertificate[]
  game                   Game                @relation(fields: [gameId], references: [id])

  @@unique([gameId, name])
}

model HealthCertificate {
  id             String               @id @default(cuid())
  animalId       String
  certDefId      String
  issuedCycle    Int
  issuedAt       DateTime             @default(now())
  expiresAtCycle Int
  isValid        Boolean              @default(true)
  animal         Animal               @relation(fields: [animalId], references: [id])
  certDef        HealthCertificateDef @relation(fields: [certDefId], references: [id])

  @@unique([animalId, certDefId])
}

model VetVisitLog {
  id              String              @id @default(cuid())
  animalId        String
  playerAccountId String
  vetServiceDefId String?
  conditionDefId  String?
  visitCycle      Int
  notes           String?
  visitedAt       DateTime            @default(now())
  vetServiceDef   VetServiceDef?      @relation(fields: [vetServiceDefId], references: [id])
  conditionDef    HealthConditionDef? @relation(fields: [conditionDefId], references: [id])
  animal          Animal              @relation(fields: [animalId], references: [id])
  playerAccount   PlayerAccount       @relation(fields: [playerAccountId], references: [id])
}

model AnimalImmunity {
  id        String   @id @default(cuid())
  animalId  String   @unique
  value     Float
  innateMax Float
  animal    Animal   @relation(fields: [animalId], references: [id])
  updatedAt DateTime @updatedAt
}

model VetServiceCondition {
  vetServiceDefId String
  conditionDefId  String
  vetServiceDef   VetServiceDef      @relation(fields: [vetServiceDefId], references: [id])
  conditionDef    HealthConditionDef @relation(fields: [conditionDefId], references: [id])

  @@id([vetServiceDefId, conditionDefId])
}
