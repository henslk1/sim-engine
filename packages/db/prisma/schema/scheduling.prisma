// Scheduled work: when a game's recurring jobs are due, and what happened the
// last time each one ran.
//
// The two tables do different jobs on purpose. ScheduledTask is the trigger —
// one row per game per kind of work, holding only the next boundary. It is
// allowed to be wrong: a tick can fire late, twice, or not at all.
// ScheduledTaskRun is the claim, and it is what makes a boundary produce one
// run. unique(gameId, taskType, scheduledFor) is the whole guarantee: two
// server instances that both decide midnight is due will both try to insert
// the same row, and only one of them can.
//
// One run row is not one execution. Execution is at-least-once: a process that
// dies mid-run leaves a lease that lapses, and the next tick reclaims the same
// row and runs it again. `runner.ts` says the same thing at more length, and
// handlers are written to tolerate it.
//
// Keeping them apart is what gives catch-up. A trigger that was missed leaves
// no trace, so the old BullMQ cron could lose a midnight forever and nothing
// noticed. An unfinished claim is a row sitting in the table.

enum ScheduledTaskType {
  NIGHTLY
  COMPETITION_SWEEP
  SHOP_ROTATION
  VENUE_ROTATION
}

enum ScheduledTaskRunStatus {
  PENDING
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

// One row per game per kind of work. `nextRunAt` is recomputed from an
// absolute grid — the game's wall-clock nightly time, or the epoch-aligned
// interval for sweeps — never from when the last run finished, so a slow or
// missed run cannot walk the schedule forward.
model ScheduledTask {
  id        String             @id @default(cuid())
  gameId    String
  taskType  ScheduledTaskType
  enabled   Boolean            @default(true)
  nextRunAt DateTime
  game      Game               @relation(fields: [gameId], references: [id])
  runs      ScheduledTaskRun[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([gameId, taskType])
  @@index([enabled, nextRunAt])
}

// One row per boundary that came due. `gameId` and `taskType` are copied from
// the task rather than read through it because the unique constraint that
// makes the claim work has to live on this table, and because the admin
// throughput queries read it without a join. Both are written once at insert
// and never updated, so there is nothing to drift.
//
// The lease is how a crash recovers. A process that dies mid-run leaves the
// row RUNNING with a `leaseUntil` that stops advancing; once it is in the past
// another tick may take the run over. `attempt` stops that becoming a loop.
model ScheduledTaskRun {
  id             String                 @id @default(cuid())
  taskId         String
  gameId         String
  taskType       ScheduledTaskType
  scheduledFor   DateTime
  status         ScheduledTaskRunStatus @default(PENDING)
  claimedBy      String?
  claimedAt      DateTime?
  leaseUntil     DateTime?
  heartbeatAt    DateTime?
  attempt        Int                    @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  eligibleCount  Int                    @default(0)
  claimedCount   Int                    @default(0)
  processedCount Int                    @default(0)
  succeededCount Int                    @default(0)
  failedCount    Int                    @default(0)
  retriedCount   Int                    @default(0)
  skippedCount   Int                    @default(0)

  // ── Finalized summary ─────────────────────────────────────────────────────
  //
  // Everything below is derived from this run's `NightlyAnimalWork` and
  // `ScheduledTaskRunSample` rows, computed once when the run finishes and
  // stored here so the analytics survive those rows being pruned.
  //
  // Retention deletes the detail, never the run. A run row is tiny and there
  // are three a day; the detail is one row per animal per night, which at a
  // hundred thousand animals is what actually grows. Keeping the run means the
  // history, the comparisons and the timing baseline all keep working, and
  // `detailPrunedAt` is how the panel says "no longer retained" instead of
  // drawing a zero.
  //
  // All nullable: a run from before this existed has no summary and never
  // will, which is a different thing from a run that genuinely did nothing.

  /**
   * Items that needed more than one attempt. Not `retriedCount`, which counts retries of the run itself.
   */
  retriedItemCount     Int?
  /**
   * Pregnancies that came to term during this run.
   */
  pregnanciesCompleted Int?
  /**
   * Best rate between two consecutive progress samples.
   */
  peakRatePerSecond    Float?
  /**
   * Worker-seconds spent, which is what separates per-worker rate from wall-clock rate.
   */
  workerSeconds        Float?

  /**
   * How many items contributed a measured duration. Zero-but-not-null means the run had none.
   */
  durationMeasured Int?
  durationMinMs    Int?
  durationAvgMs    Float?
  durationP50Ms    Int?
  durationP95Ms    Int?
  durationP99Ms    Int?
  durationMaxMs    Int?

  /**
   * When this run's per-animal work and progress samples were deleted.
   */
  detailPrunedAt DateTime?

  task           ScheduledTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  game           Game                        @relation(fields: [gameId], references: [id])
  animalWork     NightlyAnimalWork[]
  samples        ScheduledTaskRunSample[]
  nightlyLog     NightlyUpdateLog?
  resolutionWork CompetitionResolutionWork[]

  @@unique([gameId, taskType, scheduledFor])
  @@index([status, leaseUntil])
  @@index([gameId, taskType, startedAt])
}
