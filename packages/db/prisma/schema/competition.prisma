enum VenueClimate {
  HOT
  WARM
  COLD
  TEMPERATE
}

enum VenueTerrain {
  FLAT
  COASTAL
  HILLY
  MOUNTAIN
}

enum CompetitionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SeasonCategoryType {
  OVERALL
  PER_BREED
  PER_DISCIPLINE
}

enum RankSubjectType {
  PLAYER
  GROUP
}

enum PrizeType {
  CURRENCY
  ITEM
}

model DisciplineDef {
  id                     String                           @id @default(cuid())
  gameId                 String
  name                   String
  description            String?
  isConformation         Boolean                          @default(false)
  isTutorialSelectable   Boolean                          @default(false)
  minLifeStageIndex      Int?
  maxLifeStageIndex      Int?
  statWeights            DisciplineStatWeight[]
  personalityWeights     DisciplinePersonalityWeight[]
  compTierDefs           CompetitionTierDef[]
  venueDisciplines       VenueDiscipline[]
  competitions           Competition[]
  animalCompTiers        AnimalCompetitionTier[]
  weeklyPoints           AnimalWeeklyPoints[]
  seasonCategories       SeasonCategory[]
  recordDefs             RecordDef[]
  titleDefs              TitleDef[]
  animalsPrimary         Animal[]                         @relation("AnimalPrimaryDiscipline")
  animalsSecondary       Animal[]                         @relation("AnimalSecondaryDiscipline")
  groups                 Group[]
  equipmentRequirements  DisciplineEquipmentRequirement[]
  templateCompTiers      AnimalTemplateCompTier[]
  game                   Game                             @relation(fields: [gameId], references: [id])
  groupEntryRequirements GroupEntryRequirement[]
  tutorialStepDefs       TutorialStepDef[]

  @@unique([gameId, name])
}

model DisciplineStatWeight {
  id              String        @id @default(cuid())
  disciplineDefId String
  statDefId       String
  weight          Float
  statDef         StatDef       @relation(fields: [statDefId], references: [id])
  disciplineDef   DisciplineDef @relation(fields: [disciplineDefId], references: [id])

  @@unique([disciplineDefId, statDefId])
}

model BreedConformationStandard {
  id                   String @id @default(cuid())
  breedId              String
  locusId              String
  idealExpressionLabel String
  weight               Float
  locus                Locus  @relation(fields: [locusId], references: [id])
  breed                Breed  @relation(fields: [breedId], references: [id])

  @@unique([breedId, locusId, idealExpressionLabel])
}

model BreedCoatSelection {
  id         String @id @default(cuid())
  breedId    String
  expression String
  colorRole  String
  breed      Breed  @relation(fields: [breedId], references: [id])

  @@unique([breedId, expression])
}

model BreedCoatDqSelection {
  id         String @id @default(cuid())
  breedId    String
  expression String
  colorRole  String
  breed      Breed  @relation(fields: [breedId], references: [id])

  @@unique([breedId, expression])
}

model CompetitionTierDef {
  id                             String                  @id @default(cuid())
  gameId                         String
  disciplineDefId                String
  name                           String
  tierIndex                      Int
  minConditionScore              Float?
  advancementThreshold           Float?
  energyCost                     Float                   @default(0)
  entryFee                       Int
  minWeeklyPointsForInvitational Float?
  animalTiers                    AnimalCompetitionTier[]
  tierPrizes                     CompetitionTierPrize[]
  competitionEntries             CompetitionEntry[]
  competitions                   Competition[]
  disciplineDef                  DisciplineDef           @relation(fields: [disciplineDefId], references: [id])
  game                           Game                    @relation(fields: [gameId], references: [id])

  @@unique([disciplineDefId, tierIndex])
}

model Venue {
  id               String            @id @default(cuid())
  gameId           String
  name             String
  climate          VenueClimate
  terrain          VenueTerrain
  groupId          String?           @unique
  rotationOrder    Int?
  disciplines      VenueDiscipline[]
  competitions     Competition[]
  tutorialStepDefs TutorialStepDef[]
  group            Group?            @relation(fields: [groupId], references: [id])
  game             Game              @relation(fields: [gameId], references: [id])

  @@unique([gameId, name])
}

model VenueDiscipline {
  id                       String        @id @default(cuid())
  venueId                  String
  disciplineDefId          String
  defaultMaxEntries        Int
  defaultMaxWaitHours      Int
  invitationalMaxEntries   Int?
  invitationalMaxWaitHours Int?
  maxOpenAtOnce            Int           @default(1)
  isInvitationalEligible   Boolean       @default(false)
  disciplineDef            DisciplineDef @relation(fields: [disciplineDefId], references: [id])
  venue                    Venue         @relation(fields: [venueId], references: [id])

  @@unique([venueId, disciplineDefId])
}

model ExpressionClimateModifier {
  id               String         @id @default(cuid())
  expressionRuleId String
  climate          VenueClimate
  modifier         Float
  expressionRule   ExpressionRule @relation(fields: [expressionRuleId], references: [id])

  @@unique([expressionRuleId, climate])
}

model ExpressionTerrainModifier {
  id               String         @id @default(cuid())
  expressionRuleId String
  terrain          VenueTerrain
  modifier         Float
  expressionRule   ExpressionRule @relation(fields: [expressionRuleId], references: [id])

  @@unique([expressionRuleId, terrain])
}

model Season {
  id           String           @id @default(cuid())
  gameId       String
  name         String
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean          @default(false)
  categories   SeasonCategory[]
  rankings     SeasonRanking[]
  competitions Competition[]
  game         Game             @relation(fields: [gameId], references: [id])
}

model SeasonCategory {
  id              String              @id @default(cuid())
  seasonId        String
  name            String
  categoryType    SeasonCategoryType
  breedId         String?
  disciplineDefId String?
  rankings        SeasonRanking[]
  prizeConfigs    SeasonPrizeConfig[]
  disciplineDef   DisciplineDef?      @relation(fields: [disciplineDefId], references: [id])
  breed           Breed?              @relation(fields: [breedId], references: [id])
  season          Season              @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, name])
}

model SeasonPrizeConfig {
  id               String         @id @default(cuid())
  seasonCategoryId String
  currencyDefId    String?
  itemDefId        String?
  rankFrom         Int
  rankTo           Int
  prizeType        PrizeType
  amount           Int
  itemDef          ItemDef?       @relation(fields: [itemDefId], references: [id])
  currencyDef      CurrencyDef?   @relation(fields: [currencyDefId], references: [id])
  seasonCategory   SeasonCategory @relation(fields: [seasonCategoryId], references: [id])

  @@unique([seasonCategoryId, rankFrom, rankTo])
}

model RecordDef {
  id              String         @id @default(cuid())
  gameId          String
  name            String
  description     String?
  recordType      String
  subjectType     String
  disciplineDefId String?
  breedId         String?
  statDefId       String?
  entries         RecordEntry[]
  statDef         StatDef?       @relation(fields: [statDefId], references: [id])
  breed           Breed?         @relation(fields: [breedId], references: [id])
  disciplineDef   DisciplineDef? @relation(fields: [disciplineDefId], references: [id])
  game            Game           @relation(fields: [gameId], references: [id])

  @@unique([gameId, name])
}

model DirectoryFilterDef {
  id           String  @id @default(cuid())
  gameId       String
  filterKey    String
  displayLabel String
  filterType   String
  isEnabled    Boolean @default(true)
  sortOrder    Int?
  game         Game    @relation(fields: [gameId], references: [id])

  @@unique([gameId, filterKey])
}

model Competition {
  id                      String              @id @default(cuid())
  gameId                  String
  venueId                 String
  disciplineDefId         String
  tierDefId               String?
  seasonId                String?
  name                    String
  maxEntries              Int
  maxWaitHours            Int
  breedId                 String?
  status                  CompetitionStatus
  isInvitational          Boolean             @default(false)
  tutorialPlayerAccountId String?
  tutorialNpcData         Json?
  entries                 CompetitionEntry[]
  campaignPhaseDefId      String?
  breed                   Breed?              @relation(fields: [breedId], references: [id])
  campaignPhase           CampaignPhaseDef?   @relation(fields: [campaignPhaseDefId], references: [id])
  season                  Season?             @relation(fields: [seasonId], references: [id])
  tierDef                 CompetitionTierDef? @relation(fields: [tierDefId], references: [id])
  disciplineDef           DisciplineDef       @relation(fields: [disciplineDefId], references: [id])
  venue                   Venue               @relation(fields: [venueId], references: [id])
  game                    Game                @relation(fields: [gameId], references: [id])
  tutorialPlayerAccount   PlayerAccount?      @relation("TutorialCompetitions", fields: [tutorialPlayerAccountId], references: [id])
  createdAt               DateTime            @default(now())
  // When this competition is due to be resolved, and null while it has none.
  //
  // Null is the whole point. The old `expiresAt` was set at creation to
  // `now + maxWaitHours`, so every competition came due whether or not anybody
  // had entered it - which is how 4,312 competitions were resolved with zero
  // entries between them, and 1,078 empty ones were regenerated every hour.
  // Nothing happened, so there is nothing to compute.
  //
  // It is set when the FIRST entry arrives, to the next competition-sweep
  // boundary - not to `now + maxWaitHours`. A deadline measured from whenever
  // someone happened to enter is exactly the drift that anchoring the sweep to
  // an absolute grid removes. Entering at 13:59 means it runs at 14:00, and
  // that short window is a guarantee of the system rather than a defect.
  //
  // `maxWaitHours` survives on this model for invitationals, whose boundary is
  // the next nightly rather than the next sweep.
  closesAt                DateTime?

  resolutionWork CompetitionResolutionWork?

  // The sweep's query: this game's open competitions that have come due.
  @@index([gameId, status, closesAt])
}

// One competition's turn to be resolved.
//
// Resolution itself was already crash-safe before this existed: `runCompetition`
// does the whole thing — the OPEN -> IN_PROGRESS claim, scoring, results,
// prizes, group finance, weekly points and the final COMPLETED — inside a
// single transaction, so a process that dies mid-resolution rolls back and the
// competition is simply OPEN again. IN_PROGRESS never outlives a crash; it is
// mutual exclusion against a concurrent caller, not a persisted state.
//
// What this table adds is everything around that:
//
//   * **Retry accounting.** A competition that throws was previously retried on
//     every sweep forever, logged to the console, never given up on and visible
//     nowhere. `attempt` and `errorMessage` make a failing competition a record
//     rather than a recurring surprise.
//   * **Work off the request path.** Filling a competition used to resolve it
//     inside the entering player's mutation.
//   * **Chunked processing.** The sweep resolved every due competition in one
//     serial loop while holding its lease — 571 of them took 12.5 seconds.
//     Enqueueing instead lets the resolver take them a chunk at a time.
//   * **Analytics**, on the same footing as `NightlyAnimalWork`.
//
// It reuses `ScheduledTaskRunStatus` for the same reason the nightly's queue
// does: the states are genuinely the same ones.
model CompetitionResolutionWork {
  id            String @id @default(cuid())
  // One row per competition, ever. This is what makes enqueueing idempotent —
  // the sweep and a competition filling up can both ask for the same work and
  // only one row results.
  competitionId String @unique
  gameId        String

  status       ScheduledTaskRunStatus @default(PENDING)
  attempt      Int                    @default(0)
  claimedBy    String?
  leaseUntil   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime               @default(now())

  // Which sweep asked for this, when a sweep did.
  //
  // Null on purpose for the other half: a competition that fills up enqueues
  // itself from the entering player's transaction, and there is no run behind
  // that. Without this column the analytics could only ever show the game's
  // whole queue as it stands, which is honest for a sweep still draining and
  // actively misleading for one from last week - work rows outlive their
  // sweeps, so every old sweep showed the same all-time totals.
  //
  // SetNull rather than Cascade, for the same reason `NightlyUpdateLog.runId`
  // is: runs are the prunable half of this pair, and losing the attribution is
  // not a reason to lose the record of the work.
  runId String?
  run   ScheduledTaskRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  // Cascade, so the nightly's collection of competitions whose entrants are all
  // buried is not blocked by a leftover work row.
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  game        Game        @relation(fields: [gameId], references: [id])

  // Claiming the next chunk for a game, and counting what is left.
  @@index([gameId, status])
  // Finding items whose owner died.
  @@index([status, leaseUntil])
  // One sweep's share of the queue, for the run detail.
  @@index([runId])
}

model CompetitionEntry {
  id              String                 @id @default(cuid())
  competitionId   String
  animalId        String
  playerAccountId String
  tierDefId       String
  enteredAt       DateTime               @default(now())
  cycleNumber     Int?
  result          CompetitionResult?
  entryStats      CompetitionEntryStat[]
  tierDef         CompetitionTierDef     @relation(fields: [tierDefId], references: [id])
  playerAccount   PlayerAccount          @relation(fields: [playerAccountId], references: [id])
  animal          Animal                 @relation(fields: [animalId], references: [id])
  competition     Competition            @relation(fields: [competitionId], references: [id])

  @@unique([competitionId, animalId])

  @@index([animalId, cycleNumber])
}

model CompetitionEntryStat {
  id           String           @id @default(cuid())
  entryId      String
  statDefId    String
  trainedValue Float
  entry        CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  statDef      StatDef          @relation(fields: [statDefId], references: [id])

  @@unique([entryId, statDefId])
}

model CompetitionResult {
  id        String           @id @default(cuid())
  entryId   String           @unique
  placement Int?
  score     Float
  entry     CompetitionEntry @relation(fields: [entryId], references: [id])
}

model AnimalCompetitionTier {
  id              String             @id @default(cuid())
  animalId        String
  disciplineDefId String
  tierDefId       String
  tierDef         CompetitionTierDef @relation(fields: [tierDefId], references: [id])
  disciplineDef   DisciplineDef      @relation(fields: [disciplineDefId], references: [id])
  animal          Animal             @relation(fields: [animalId], references: [id])

  @@unique([animalId, disciplineDefId])
}

model AnimalWeeklyPoints {
  id              String        @id @default(cuid())
  animalId        String
  disciplineDefId String
  weekStart       DateTime
  points          Float
  disciplineDef   DisciplineDef @relation(fields: [disciplineDefId], references: [id])
  animal          Animal        @relation(fields: [animalId], references: [id])

  @@unique([animalId, disciplineDefId, weekStart])
}

model SeasonRanking {
  id              String          @id @default(cuid())
  seasonId        String
  categoryId      String
  subjectTypeId   RankSubjectType
  playerAccountId String?
  groupId         String?
  rank            Int
  score           Float
  group           Group?          @relation(fields: [groupId], references: [id])
  playerAccount   PlayerAccount?  @relation(fields: [playerAccountId], references: [id])
  category        SeasonCategory  @relation(fields: [categoryId], references: [id])
  season          Season          @relation(fields: [seasonId], references: [id])
}

model RecordEntry {
  id              String         @id @default(cuid())
  recordDefId     String
  playerAccountId String?
  animalId        String?
  groupId         String?
  value           Float
  setAt           DateTime       @default(now())
  group           Group?         @relation(fields: [groupId], references: [id])
  animal          Animal?        @relation(fields: [animalId], references: [id])
  playerAccount   PlayerAccount? @relation(fields: [playerAccountId], references: [id])
  recordDef       RecordDef      @relation(fields: [recordDefId], references: [id])
}

model DisciplinePersonalityWeight {
  id              String              @id @default(cuid())
  disciplineDefId String
  traitDefId      String
  idealMin        Float
  idealMax        Float
  bonusPercent    Float
  disciplineDef   DisciplineDef       @relation(fields: [disciplineDefId], references: [id])
  traitDef        PersonalityTraitDef @relation(fields: [traitDefId], references: [id])

  @@unique([disciplineDefId, traitDefId])
}

model CompetitionTierPrize {
  id             String             @id @default(cuid())
  tierDefId      String
  placement      Int
  currencyDefId  String?
  amount         Int
  isInvitational Boolean            @default(false)
  tierDef        CompetitionTierDef @relation(fields: [tierDefId], references: [id])
  currencyDef    CurrencyDef?       @relation(fields: [currencyDefId], references: [id])

  @@unique([tierDefId, placement, isInvitational])
}

model DisciplineEquipmentRequirement {
  id               String        @id @default(cuid())
  disciplineDefId  String
  itemDefId        String
  quantity         Int           @default(1)
  requirementGroup String?
  disciplineDef    DisciplineDef @relation(fields: [disciplineDefId], references: [id])
  itemDef          ItemDef       @relation(fields: [itemDefId], references: [id])

  @@unique([disciplineDefId, itemDefId])
}
